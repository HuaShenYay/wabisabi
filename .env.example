# Sanity CMS configuration
# Get these from https://www.sanity.io/manage after creating a project
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Use posts for an existing Post-based Studio; all enables the complete portfolio schema.
SANITY_CONTENT_SCOPE=all
# Optional: enable read token for private datasets
SANITY_API_READ_TOKEN=
# Optional: used ONLY by the explicit content import command, never by the website
SANITY_API_WRITE_TOKEN=
