{
	"name": "portfolio-sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "vitest run --config vitest.config.ts",
		"sanity:seed": "node scripts/sanity-seed.mjs",
		"studio:dev": "vite --config sanity/studio.vite.config.js dev",
		"studio:build": "vite --config sanity/studio.vite.config.js build",
		"studio:deploy": "cd sanity && sanity deploy --schema-required",
		"sanity:site-plan": "cd sanity && sanity exec ../scripts/sanity-site-seed.mjs --with-user-token",
		"sanity:site-import": "cd sanity && sanity exec ../scripts/sanity-site-seed.mjs --with-user-token -- --apply"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/three": "^0.186.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@sanity/cli": "^8.13.0",
		"@sanity/client": "^8.8.0",
		"@sanity/image-url": "^2.1.1",
		"@sanity/vision": "^6.16.0",
		"@vitejs/plugin-react": "^6.1.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sanity": "^6.16.0",
		"styled-components": "^6.5.3",
		"three": "^0.186.1"
	}
}
